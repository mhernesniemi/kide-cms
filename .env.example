# AI Assistant (optional — disabled when empty)
AI_PROVIDER=openai
AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini

# Resend email (optional — invite links shown manually when empty)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kide CMS <noreply@yourdomain.com>

# Scheduled publishing / task auth. Optional in dev; required in production, where the
# cron endpoints return 401 until it is set.
CRON_SECRET=

# Node target only. Persist the SQLite DB and uploads outside the release tree so they
# survive deploys. Default to public/uploads and ./data/cms.db when unset.
CMS_UPLOADS_DIR=
CMS_DATABASE_URL=
