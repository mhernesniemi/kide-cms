---
import { renderRichText, stripMissingAssetImages } from "@kidecms/core";

const { content, className } = Astro.props;
const parsed =
  typeof content === "string"
    ? (() => {
        try {
          return JSON.parse(content);
        } catch {
          return null;
        }
      })()
    : content;
// Inline images whose upload is gone would render as a <picture> of 404s.
const html = renderRichText(await stripMissingAssetImages(parsed));
---

{html && <div class:list={["prose", className]} set:html={html} />}
