---
import PublicLayout from "@/layouts/PublicLayout.astro";
---

<PublicLayout>
  <main class="mx-auto max-w-2xl px-4 py-16 text-gray-700">
    <h1 class="mb-6 text-2xl font-bold">Kide CMS</h1>
    <p class="mb-4">
      Open the <a href="/admin" class="text-blue-700 underline">admin</a> to create your first page.
    </p>
    <p class="mb-4">
      To shape your content model, add collections in <code class="bg-gray-200 px-1">src/cms/collections/</code> and register
      them in <code class="bg-gray-200 px-1">cms.config.ts</code>.
    </p>
    <p>
      Learn more in the <a href="https://docs.kide.dev" target="_blank" class="text-blue-700 underline">docs</a>.
    </p>
  </main>
</PublicLayout>
