---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { cms } from "@/cms/.generated/api";

const isPreview = Astro.url.searchParams.has("preview");
const doc = await cms.examples.findById(Astro.params.id!, { status: isPreview ? "any" : "published" });
if (!doc) return Astro.redirect("/");
---

<PublicLayout title={doc.title}>
  <article class="mx-auto max-w-2xl px-4 py-8">
    <a href="/" class="text-sm text-teal-700">&larr; Back</a>
    <h1 data-cms="title" class="mt-4 mb-2 text-2xl font-semibold">
      {doc.title}
    </h1>
    <p data-cms="body" class="whitespace-pre-line text-gray-700">
      {doc.body}
    </p>
  </article>
</PublicLayout>
