---
import "virtual:kide/admin-css";

import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/cms/admin/components/ui/card";
import { Input } from "@/cms/admin/components/ui/input";
import { Label } from "@/cms/admin/components/ui/label";
import { buttonVariants } from "@/cms/admin/components/ui/button";

export const prerender = false;

const error = Astro.url.searchParams.get("error");
const errorMessage =
  error === "invalid"
    ? "That code was not correct. Try again."
    : error === "missing"
      ? "Enter the code from your authenticator app."
      : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>Two-factor authentication | Kide CMS</title>
  </head>
  <body class="bg-background text-foreground min-h-screen antialiased">
    <div class="flex min-h-screen items-center justify-center px-4">
      <div class="w-full max-w-sm space-y-6">
        <h1 class="text-center text-xl font-semibold tracking-tight">Kide CMS</h1>
        <Card>
          <CardHeader>
            <CardTitle>Two-factor authentication</CardTitle>
            <CardDescription>Enter the 6-digit code from your authenticator app</CardDescription>
          </CardHeader>
          <CardContent>
            {
              errorMessage && (
                <div class="border-destructive/50 bg-destructive/10 text-destructive mb-4 rounded-lg border px-3 py-2 text-sm">
                  {errorMessage}
                </div>
              )
            }
            <form method="post" action="/api/cms/auth/two-factor-login" class="grid gap-4">
              <div class="grid gap-2">
                <Label htmlFor="code">Authentication code</Label>
                <Input
                  id="code"
                  name="code"
                  inputmode="numeric"
                  autocomplete="one-time-code"
                  pattern="[0-9A-Za-z-]*"
                  placeholder="123456"
                  required
                  autoFocus
                />
              </div>
              <button class={buttonVariants({ size: "lg", className: "w-full" })} type="submit"> Verify </button>
              <label class="text-muted-foreground flex items-center gap-2 text-xs">
                <input type="checkbox" name="mode" value="backup" /> Use a backup code instead
              </label>
            </form>
            <div class="mt-4 text-center">
              <a class="text-muted-foreground hover:text-foreground text-xs" href="/admin/login">Back to sign in</a>
            </div>
          </CardContent>
        </Card>
      </div>
    </div>
  </body>
</html>
