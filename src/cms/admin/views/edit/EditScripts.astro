---
// Client-side glue for the edit form: conditional field visibility, autofocus on new,
// AJAX form submit (so validation errors surface as toasts without losing form state),
// and collapsible field-group state persistence.
---

<script is:inline>
  // Collapsible field groups remember their open/closed state per collection
  // and group in localStorage, so a folded section stays folded across visits.
  (function () {
    document.querySelectorAll("details[data-fieldset-key]").forEach(function (el) {
      var key = "kide:fieldset:" + el.getAttribute("data-fieldset-key");
      try {
        var saved = localStorage.getItem(key);
        if (saved === "open") el.open = true;
        else if (saved === "closed") el.open = false;
      } catch (e) {
        /* no localStorage — schema default stays */
      }
      el.addEventListener("toggle", function () {
        try {
          localStorage.setItem(key, el.open ? "open" : "closed");
        } catch (e) {
          /* ignore */
        }
      });
    });
  })();
</script>

<script is:inline>
  (function () {
    // --- Conditional fields ---
    var conditionals = document.querySelectorAll("[data-condition-field]");
    if (conditionals.length > 0) {
      var matchesCondition = function (currentValue, expected) {
        if (Array.isArray(expected)) {
          return expected.some(function (v) {
            return String(v) === String(currentValue);
          });
        }
        if (typeof expected === "boolean") {
          return expected
            ? currentValue === "true" || currentValue === true
            : currentValue === "false" || currentValue === false || currentValue === "";
        }
        return String(expected) === String(currentValue);
      };

      var getFieldValue = function (fieldName) {
        var radio = document.querySelector('input[type="radio"][name="' + fieldName + '"]:checked');
        if (radio) return radio.value;
        if (document.querySelector('input[type="radio"][name="' + fieldName + '"]')) return "";
        var checkbox = document.querySelector('input[type="checkbox"][name="' + fieldName + '"]');
        if (checkbox) return checkbox.checked ? "true" : "false";
        var hidden = document.querySelector('input[type="hidden"][name="' + fieldName + '"]');
        if (hidden) return hidden.value;
        var input = document.querySelector('[name="' + fieldName + '"]');
        if (input) return input.value;
        return "";
      };

      var updateVisibility = function () {
        conditionals.forEach(function (el) {
          var depField = el.getAttribute("data-condition-field");
          var expected = JSON.parse(el.getAttribute("data-condition-value"));
          var currentValue = getFieldValue(depField);
          var visible = matchesCondition(currentValue, expected);
          var target = el.parentElement && el.parentElement.childElementCount === 1 ? el.parentElement : el;
          target.style.display = visible ? "" : "none";
          el.querySelectorAll("input, textarea, select").forEach(function (input) {
            input.disabled = !visible;
          });
        });
      };

      updateVisibility();
      var form = document.getElementById("document-form");
      if (form) {
        form.addEventListener("input", updateVisibility);
        form.addEventListener("change", updateVisibility);
      }
    }
  })();
</script>

<script is:inline>
  // A toast alone leaves the editor hunting for which field it means — especially
  // in a long form where the culprit may sit inside a collapsed group. Point at it:
  // open its group, scroll it into view, focus it, and mark it invalid until touched.
  function clearInvalidMarks() {
    // Both markers, because they are mutually exclusive: an input carries
    // aria-invalid only, a composite control carries data-cms-invalid only.
    // Scoped to the form so a component managing its own aria-invalid is untouched.
    var form = document.getElementById("document-form");
    if (!form) return;
    form.querySelectorAll("[data-cms-invalid], [aria-invalid='true']").forEach(function (el) {
      el.removeAttribute("data-cms-invalid");
      el.removeAttribute("aria-invalid");
    });
  }

  function highlightInvalidField(fieldName) {
    clearInvalidMarks();
    if (!fieldName) return;
    var wrapper = document.querySelector('[data-field-name="' + CSS.escape(fieldName) + '"]');
    if (!wrapper) return;

    // Collapsible groups are <details>; a field inside a closed one is invisible.
    var group = wrapper.closest("details");
    if (group && !group.open) group.open = true;

    var control = wrapper.querySelector("input, textarea, select, [contenteditable='true']");
    if (control) {
      // Inputs and textareas already style [aria-invalid]; adding the fallback
      // outline on top of that border+ring reads as an error about an error.
      control.setAttribute("aria-invalid", "true");
    } else {
      wrapper.setAttribute("data-cms-invalid", "");
    }
    // Drop the mark as soon as they start fixing it — keeping it red while someone
    // types is nagging, and the server re-marks on the next submit if still wrong.
    // Listening on the wrapper covers composite controls (pickers, block editors)
    // whose events come from a child rather than an input we can find.
    wrapper.addEventListener("input", clearInvalidMarks, { once: true });
    wrapper.addEventListener("change", clearInvalidMarks, { once: true });
    wrapper.scrollIntoView({ behavior: "smooth", block: "center" });
    if (control && typeof control.focus === "function") {
      setTimeout(function () {
        control.focus({ preventScroll: true });
      }, 300);
    }
  }

  function showErrorToast(msg, fieldName) {
    var existing = document.getElementById("admin-toast");
    if (existing) existing.parentElement.remove();
    var w = document.createElement("div");
    w.className = "fixed top-4 left-1/2 z-50 w-full max-w-sm -translate-x-1/2";
    w.innerHTML =
      '<div id="admin-toast" role="alert" class="bg-card flex items-center gap-2 rounded-lg border border-red-500/30 px-5 py-3 text-sm shadow-lg" style="animation:toast-in .25s ease-out,toast-out .3s ease-in 4.7s forwards">' +
      '<svg class="size-4 shrink-0 text-red-600 dark:text-red-400" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" x2="12" y1="8" y2="12"/><line x1="12" x2="12.01" y1="16" y2="16"/></svg>' +
      '<span class="text-red-700 dark:text-red-400"></span></div>';
    // Carries document data (hook errors quote field values) — never innerHTML.
    w.querySelector("span").textContent = msg;
    document.body.appendChild(w);
    setTimeout(function () {
      w.remove();
    }, 5200);
    highlightInvalidField(fieldName);
  }

  // The browser's own bubble is OS-styled, says "Please fill out this field", and
  // shows only one field at a time — three ways it disagrees with how the admin
  // reports the identical error from the server. Keep the browser's constraint
  // engine (required, maxlength, type=email all still apply) and replace only its
  // presentation, so a missing Title looks the same whoever caught it.
  function reportClientValidity(f) {
    if (f.checkValidity()) return true;
    var invalid = f.querySelector(":invalid");
    if (!invalid) return false;
    var wrapper = invalid.closest("[data-field-name]");
    var fieldName = wrapper ? wrapper.getAttribute("data-field-name") : null;
    var label = wrapper ? wrapper.querySelector("label") : null;
    var labelText = label ? label.textContent.replace(/\*/g, "").trim() : "";
    showErrorToast(labelText ? labelText + " is required." : invalid.validationMessage, fieldName);
    return false;
  }

  (function () {
    var form = document.getElementById("document-form");
    if (!form) return;
    if (location.pathname.endsWith("/new")) {
      var first = form.querySelector('input[type="text"], textarea');
      if (first) first.focus();
    }
    // Suppress the native bubbles; reportClientValidity() below re-runs the same
    // checks and presents them in the admin's own language.
    form.setAttribute("novalidate", "");
    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var f = e.target;
      if (!reportClientValidity(f)) return;
      var sub = e.submitter;
      var fd = new FormData(f);
      if (sub && sub.name && sub.value) fd.set(sub.name, sub.value);
      fetch(f.action, {
        method: f.method || "POST",
        body: new URLSearchParams(fd),
        headers: { "Content-Type": "application/x-www-form-urlencoded" },
      })
        .then(function (res) {
          var u = new URL(res.url);
          if (u.searchParams.get("_toast") === "error") {
            showErrorToast(
              decodeURIComponent(u.searchParams.get("_msg") || "Something went wrong"),
              u.searchParams.get("_field"),
            );
            return;
          }
          if (u.searchParams.get("_toast") === "success") {
            try {
              new BroadcastChannel("cms-preview").postMessage({ type: "reload" });
            } catch (e) {}
          }
          if (window.parent !== window && u.searchParams.get("_toast") === "success") {
            var idMatch = u.pathname.match(/\/admin\/[^/]+\/([^/]+)/);
            if (idMatch) {
              window.parent.postMessage({ type: "cms:created", id: idMatch[1] }, "*");
              return;
            }
          }
          window.location.assign(res.url);
        })
        .catch(function () {
          f.submit();
        });
    });
  })();
</script>
