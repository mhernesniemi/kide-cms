---
import DocumentsDataTable from "../components/DocumentsDataTable";
import config from "virtual:kide/config";
import { cms } from "virtual:kide/api";
import { formatDate, getTranslatableFieldNames } from "../../core";
import { canRead } from "../lib/access";

const user = Astro.locals.user;
const runtimeContext = user ? { user } : {};
const cmsRuntime = cms as Record<string, any>;
const defaultLocale = config.locales?.default ?? "en";
const locales = config.locales?.supported ?? [];

const singletonCollections = config.collections.filter((c) => c.singleton && canRead(config, user, c.slug));
// Same rule as ListView: a Locales column is only meaningful with more than one
// locale and at least one singleton having translatable fields.
const showLocalesColumn =
  locales.length > 1 && singletonCollections.some((c) => getTranslatableFieldNames(c).length > 0);
const singletonsData = await Promise.all(
  singletonCollections.map(async (sc) => {
    const api = cmsRuntime[sc.slug];
    const singleDocs = await api.find({ status: "any", limit: 1, locale: defaultLocale }, runtimeContext);
    const singleDoc = singleDocs[0] ?? null;
    return {
      id: singleDoc ? String(singleDoc._id) : "",
      collectionSlug: sc.slug,
      label: sc.labels.singular,
      status: singleDoc && sc.drafts ? String(singleDoc._status ?? "draft") : "",
      locales: singleDoc
        ? [
            defaultLocale,
            ...(Array.isArray(singleDoc._availableLocales)
              ? singleDoc._availableLocales.filter((l: string) => l !== defaultLocale)
              : []),
          ]
        : [],
      updatedAt: singleDoc ? formatDate(singleDoc._updatedAt) : "—",
      editHref: `/admin/${sc.slug}`,
    };
  }),
);
---

<section class="space-y-6 px-4 py-6 lg:py-8 lg:pr-8 lg:pl-12">
  <div class="flex items-start justify-between gap-4">
    <h1 class="text-2xl font-semibold tracking-tight">Singles</h1>
  </div>
  <DocumentsDataTable
    client:load
    collectionSlug="singles"
    draftsEnabled={true}
    duplicateEnabled={false}
    title="Singles"
    columns={[
      { key: "name", label: "Name" },
      { key: "slug", label: "API slug" },
      ...(singletonCollections.some((c) => c.drafts) ? [{ key: "_status", label: "Status" }] : []),
      { key: "updatedAt", label: "Last updated" },
    ]}
    data={singletonsData.map((s) => ({
      id: s.id,
      collectionSlug: s.collectionSlug,
      editHref: s.editHref,
      locales: s.locales,
      searchText: `${s.label} ${s.collectionSlug}`,
      values: { name: s.label, slug: s.collectionSlug, _status: s.status, updatedAt: s.updatedAt },
    }))}
    searchPlaceholder="Filter singles..."
    showLocalesColumn={showLocalesColumn}
  />
</section>
