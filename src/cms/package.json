{
  "name": "@kidecms/core",
  "version": "0.43.1",
  "description": "Kide CMS runtime — core library, admin UI, routes, and middleware for Astro. Shipped as TypeScript source.",
  "keywords": [
    "cms",
    "astro",
    "content-management",
    "typescript",
    "admin-panel"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://docs.kide.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/mhernesniemi/kide-cms.git"
  },
  "bugs": "https://github.com/mhernesniemi/kide-cms/issues",
  "engines": {
    "node": ">=22.23.4"
  },
  "bin": {
    "kide": "./internals/cli.mjs"
  },
  "exports": {
    ".": "./core/index.ts",
    "./astro": "./internals/integration.ts",
    "./vite": "./internals/vite-plugin.ts",
    "./handler": "./routes/handler.ts",
    "./sveltekit": "./internals/sveltekit/index.mjs",
    "./sveltekit/hooks": "./internals/sveltekit/hooks.ts",
    "./context": "./internals/context.ts",
    "./youtube": "./core/youtube.ts",
    "./shared-sections": "./core/shared-sections.ts",
    "./client/preview": "./client/preview.ts",
    "./platform/*": "./platform/*.ts",
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "files": [
    "admin",
    "client",
    "core",
    "internals",
    "middleware",
    "platform",
    "routes",
    "!**/__tests__",
    "!**/__snapshots__",
    "!**/*.test.ts",
    "!**/*.workers.test.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.118",
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "1.7.23",
    "@better-auth/utils": "0.5.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-image": "3.34.0",
    "@tiptap/extension-link": "3.34.0",
    "@tiptap/extension-placeholder": "3.34.0",
    "@tiptap/markdown": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/react": "3.34.0",
    "@tiptap/starter-kit": "3.34.0",
    "@tiptap/suggestion": "3.34.0",
    "ai": "^7.0.173",
    "aws4fetch": "^1.0.20",
    "better-auth": "1.7.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-kit": "^0.31.11",
    "lucide-react": "^1.73.0",
    "nanoid": "^6.0.2",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^3.0.0",
    "astro": "^7.0.0",
    "better-sqlite3": "^12.0.0 || ^13.0.0",
    "drizzle-orm": "^0.45.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.0",
    "svelte": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^8.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    },
    "astro": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "sharp": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  }
}
