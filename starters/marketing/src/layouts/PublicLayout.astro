---
import "@/styles/public.css";
import { cms } from "@/cms/.generated/api";
import { safeUrl } from "@kidecms/core";

const { title = "Acme", description = "A marketing site powered by Kide CMS." } = Astro.props;
type MenuItem = { id: string; label?: string; href?: string; target?: string; children: MenuItem[] };

const menu = await cms.menus.findOne({ slug: "main" });
// Preview responses must never enter the cache (set() would re-enable a
// page-level set(false), so the tag is skipped entirely on preview).
if (!Astro.url.searchParams.has("preview")) Astro.cache.set({ tags: ["menus"] });
const rawItems: MenuItem[] = Array.isArray(menu?.items) ? menu.items : [];
// Menu hrefs are CMS-authored content — sanitize and drop anything unsafe.
const menuItems = rawItems
  .map((item) => ({ ...item, href: safeUrl(String(item.href ?? "")) }))
  .filter((item) => item.href !== null);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col overflow-x-clip bg-white text-gray-950 antialiased">
    <header class="border-b border-gray-200">
      <div class="mx-auto flex max-w-5xl items-center gap-10 px-6 py-5">
        <a href="/" class="text-base font-semibold tracking-tight no-underline">Acme</a>
        {
          menuItems.length > 0 && (
            <nav>
              <ul class="flex list-none gap-7 p-0">
                {menuItems.map((item) => (
                  <li>
                    <a
                      href={item.href}
                      target={item.target || undefined}
                      rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
                      class="text-sm text-gray-500 no-underline transition-colors hover:text-gray-950"
                    >
                      {String(item.label ?? "")}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <a
          href="/admin"
          class="ml-auto rounded-full border border-gray-200 px-3.5 py-1.5 text-sm text-gray-600 no-underline transition-colors hover:border-gray-300 hover:text-gray-950"
        >
          Open admin
        </a>
      </div>
    </header>
    <div class="flex-1">
      <slot />
    </div>
    <footer class="border-t border-gray-200">
      <div class="mx-auto flex max-w-5xl items-baseline justify-between px-6 py-10">
        <p class="m-0 text-sm text-gray-500">&copy; {new Date().getFullYear()} Acme</p>
        <p class="m-0 text-sm text-gray-400">
          Built with{" "}
          <a href="https://kide.dev" class="text-gray-500 no-underline hover:text-gray-950">Kide CMS</a>
        </p>
      </div>
    </footer>
  </body>
</html>
