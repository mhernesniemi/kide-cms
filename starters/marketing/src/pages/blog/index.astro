---
import PublicLayout from "@/layouts/PublicLayout.astro";
import { cms } from "@/cms/.generated/api";

const posts = await cms.posts.find({
  status: "published",
  sort: { field: "_publishedAt", direction: "desc" },
  limit: 50,
});

Astro.cache.set({ tags: ["posts"] });
---

<PublicLayout title="Blog" description="News, guides, and customer stories.">
  <main class="mx-auto max-w-2xl px-6 py-14 sm:py-20">
    <h1 class="mb-10 text-3xl font-semibold tracking-tight sm:text-4xl">Blog</h1>
    {posts.length === 0 && <p class="text-gray-500">No published posts yet.</p>}
    <ul class="m-0 grid list-none gap-0 divide-y divide-gray-100 p-0">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}`} class="group block py-6 no-underline">
              <article>
                {post._publishedAt && (
                  <time class="mb-1 block text-xs text-gray-400" datetime={String(post._publishedAt)}>
                    {new Date(String(post._publishedAt)).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </time>
                )}
                <h2 class="mb-1.5 text-lg font-medium transition-colors group-hover:text-gray-500">{post.title}</h2>
                {post.excerpt && <p class="m-0 text-sm leading-relaxed text-gray-600">{post.excerpt}</p>}
              </article>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</PublicLayout>
