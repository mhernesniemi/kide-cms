---
import PublicLayout from "@/layouts/PublicLayout.astro";
import ContentRenderer from "@/components/ContentRenderer.astro";
import CmsPicture from "@/components/CmsPicture.astro";
import { cms } from "@/cms/.generated/api";
import { cacheTags } from "@kidecms/core";

const isPreview = Astro.url.searchParams.has("preview");
const doc = await cms.posts.findOne({ slug: Astro.params.slug!, status: isPreview ? "any" : "published" });
if (!doc) {
  Astro.cache.set(false); // an untagged cached redirect would pin a not-yet-published URL
  return Astro.redirect("/blog");
}

if (isPreview) Astro.cache.set(false);
else Astro.cache.set({ tags: cacheTags("posts", doc._id) });
---

<PublicLayout title={doc.title} description={doc.seoDescription} cmsDoc={`posts:${doc._id}`}>
  <article class="mx-auto max-w-2xl px-6 py-14 sm:py-20">
    <a href="/blog" class="text-sm text-gray-500 no-underline transition-colors hover:text-gray-950">&larr; All posts</a
    >
    <h1 data-cms="title" class="mt-6 mb-3 text-3xl font-semibold tracking-tight sm:text-4xl">{doc.title}</h1>
    {
      doc.image && (
        <CmsPicture
          src={doc.image}
          alt={doc.title}
          preset="banner"
          art={[{ media: "(max-width: 640px)", preset: "heroMobile" }]}
          sizes="(max-width: 672px) 100vw, 640px"
          loading="eager"
          fetchpriority="high"
          class="mb-6 h-auto w-full rounded-lg"
        />
      )
    }
    <p data-cms="excerpt" class="mb-8 text-lg leading-relaxed text-gray-600 empty:hidden">{doc.excerpt}</p>
    <div data-cms="body" class="prose prose-gray max-w-none">
      <ContentRenderer content={doc.body} status={isPreview ? "any" : "published"} />
    </div>
  </article>
</PublicLayout>
