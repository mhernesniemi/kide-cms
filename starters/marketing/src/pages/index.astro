---
import PublicLayout from "@/layouts/PublicLayout.astro";
import BlockRenderer from "@/components/BlockRenderer.astro";
import { cms } from "@/cms/.generated/api";
import { parseBlocks } from "@kidecms/core";

const isPreview = Astro.url.searchParams.has("preview");
const doc = await cms["front-page"].findOne({ status: isPreview ? "any" : "published" });
const blocks = parseBlocks(doc?.blocks);

if (isPreview) Astro.cache.set(false);
else Astro.cache.set({ tags: ["front-page"] });
---

<PublicLayout title="Acme" description={doc?.seoDescription}>
  <main class="mx-auto max-w-5xl px-6" data-cms="blocks">
    {
      blocks.length > 0 ? (
        <BlockRenderer blocks={blocks} status={isPreview ? "any" : "published"} />
      ) : (
        <p class="py-20 text-gray-500">
          No content yet. Open the{" "}
          <a href="/admin" class="text-gray-950 underline">
            admin
          </a>{" "}
          and publish the Front page.
        </p>
      )
    }
  </main>
</PublicLayout>
