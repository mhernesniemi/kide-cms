---
import { safeUrl } from "@kidecms/core";

const { heading, body, ctaLabel, ctaHref } = Astro.props;
// Astro escapes attribute values but does not reject URL schemes.
const href = ctaHref ? safeUrl(String(ctaHref)) : null;
const hasContent = Boolean(heading || body || (ctaLabel && href));
---

{
  hasContent && (
    <section class="py-20 sm:py-28">
      <div class="max-w-2xl">
        {heading && <h1 class="mb-5 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{heading}</h1>}
        {body && <p class="mb-8 text-lg leading-relaxed text-gray-600">{body}</p>}
        {ctaLabel && href && (
          <a
            href={href}
            class="inline-block rounded-full bg-gray-950 px-6 py-2.5 text-sm font-medium text-white no-underline transition-colors hover:bg-gray-700"
          >
            {ctaLabel}
          </a>
        )}
      </div>
    </section>
  )
}
