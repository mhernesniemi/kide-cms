---
import { resolveLinkUrl, type StoredLink } from "@kidecms/core";
import { cms } from "@/cms/.generated/api";

const { heading, body, cta } = Astro.props;
const link = cta && typeof cta === "object" ? (cta as StoredLink) : null;
// Resolves the linked document's current route (slug edits included); external
// and hand-typed URLs pass through scheme-checked.
const href = await resolveLinkUrl(cms as Record<string, any>, link);
// An empty label falls back to the linked document's title.
const linkLabel = link?.label || link?.title;
const hasContent = Boolean(heading || body || (linkLabel && href));
---

{
  hasContent && (
    <section class="mx-[calc(50%-50vw)] border-b border-gray-200 bg-gray-50">
      <div class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
        <div class="max-w-2xl">
          {heading && <h1 class="mb-5 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{heading}</h1>}
          {body && <p class="mb-8 text-lg leading-relaxed text-gray-600">{body}</p>}
          {linkLabel && href && (
            <a
              href={href}
              target={link.newTab ? "_blank" : undefined}
              rel={link.newTab ? "noopener noreferrer" : undefined}
              class="inline-block rounded-full bg-gray-950 px-6 py-2.5 text-sm font-medium text-white no-underline transition-colors hover:bg-gray-700"
            >
              {linkLabel}
            </a>
          )}
        </div>
      </div>
    </section>
  )
}
