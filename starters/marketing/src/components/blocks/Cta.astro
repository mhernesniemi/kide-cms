---
import { safeUrl } from "@kidecms/core";

const { heading, body, buttonLabel, buttonHref } = Astro.props;
const href = buttonHref ? safeUrl(String(buttonHref)) : null;
const hasContent = Boolean(heading || body || (buttonLabel && href));
---

{
  hasContent && (
    <section class="rounded-lg bg-gray-50 px-6 py-10 text-center">
      {heading && <h2 class="mb-2 text-2xl font-semibold">{heading}</h2>}
      {body && <p class="mx-auto mb-5 max-w-xl text-gray-500">{body}</p>}
      {buttonLabel && href && (
        <a
          href={href}
          class="inline-block rounded-md bg-teal-700 px-5 py-2.5 text-sm font-medium text-white no-underline hover:bg-teal-800"
        >
          {buttonLabel}
        </a>
      )}
    </section>
  )
}
