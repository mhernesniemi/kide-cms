---
import { parseList } from "@kidecms/core";

const { heading, items: rawItems } = Astro.props;
const items = parseList<{ title?: string; description?: string }>(rawItems);
const hasContent = Boolean(heading) || items.length > 0;
---

{
  hasContent && (
    <section>
      {heading && <h2 class="mb-6 text-center text-2xl font-semibold">{heading}</h2>}
      {items.length > 0 && (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {items.map((item) => (
            <div class="rounded-lg border border-gray-200 px-5 py-4">
              {item.title && <p class="mb-1 font-semibold">{item.title}</p>}
              {item.description && <p class="m-0 text-sm text-gray-500">{item.description}</p>}
            </div>
          ))}
        </div>
      )}
    </section>
  )
}
