---
import { parseList } from "@kidecms/core";

const { heading, items: rawItems } = Astro.props;
const items = parseList<{ title?: string; description?: string }>(rawItems);
const hasContent = Boolean(heading) || items.length > 0;
---

{
  hasContent && (
    <section>
      <div class="mx-[calc(50%-50vw)] border-t border-gray-200" />
      <div class="py-12 sm:py-16">
        {heading && <h2 class="mb-10 text-2xl font-semibold tracking-tight sm:text-3xl">{heading}</h2>}
        {items.length > 0 && (
          <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {items.map((item) => (
              <div class="border-l border-gray-200 pl-5">
                {item.title && <p class="mb-2 font-medium">{item.title}</p>}
                {item.description && <p class="m-0 text-sm leading-relaxed text-gray-600">{item.description}</p>}
              </div>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}
