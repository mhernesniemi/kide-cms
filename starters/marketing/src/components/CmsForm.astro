---
import { cms } from "@/cms/.generated/api";

type FormFieldConfig = {
  type: "text" | "email" | "textarea" | "select" | "checkbox";
  name: string;
  label: string;
  placeholder?: string;
  required?: boolean;
  maxLength?: number;
  rows?: number;
  options?: string[];
};

const { slug, context } = Astro.props as { slug: string; context?: Record<string, string | number | boolean> };
const form = await cms.forms.findOne({ slug });

const fieldConfigs = form && Array.isArray(form.fields) ? (form.fields as FormFieldConfig[]) : [];

const submitted = Astro.url.searchParams.get("submitted") === "1";
const formError = Astro.url.searchParams.get("formError");
const action = `/api/cms/forms/submit/${slug}`;

const inputClass =
  "rounded-md border border-gray-300 px-3.5 py-2.5 transition-colors outline-none focus:border-gray-500 focus:ring-2 focus:ring-gray-950/10";
---

{
  !form && (
    <p class="rounded border border-dashed border-gray-300 p-6 text-sm text-gray-500">
      This form has not been set up yet. Create a form with the slug "{slug}" in the admin UI.
    </p>
  )
}

{
  form && (
    <form method="POST" action={action} class="flex flex-col gap-4">
      {/* Honeypot — bots fill visible inputs; humans never see this one */}
      <input
        type="text"
        name="_hp"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;"
      />

      {/* Context metadata — page title, URL, or anything else the host page wants to attach */}
      {context &&
        Object.entries(context).map(([key, value]) => (
          <input type="hidden" name={`_ctx_${key}`} value={String(value)} />
        ))}

      {fieldConfigs.map((field) => {
        const inputId = `${slug}-${field.name}`;
        if (field.type === "textarea") {
          return (
            <label for={inputId} class="flex flex-col gap-1 text-sm">
              <span class="font-medium">
                {field.label}
                {field.required && <span aria-hidden="true"> *</span>}
              </span>
              <textarea
                id={inputId}
                name={field.name}
                rows={field.rows ?? 4}
                placeholder={field.placeholder ?? ""}
                required={field.required}
                class={inputClass}
              />
            </label>
          );
        }

        if (field.type === "select") {
          return (
            <label for={inputId} class="flex flex-col gap-1 text-sm">
              <span class="font-medium">
                {field.label}
                {field.required && <span aria-hidden="true"> *</span>}
              </span>
              <select id={inputId} name={field.name} required={field.required} class={inputClass}>
                <option value="">Select…</option>
                {(field.options ?? []).map((opt) => (
                  <option value={opt}>{opt}</option>
                ))}
              </select>
            </label>
          );
        }

        if (field.type === "checkbox") {
          return (
            <label for={inputId} class="flex items-center gap-2 text-sm">
              <input id={inputId} type="checkbox" name={field.name} required={field.required} />
              <span>
                {field.label}
                {field.required && <span aria-hidden="true"> *</span>}
              </span>
            </label>
          );
        }

        // text | email
        return (
          <label for={inputId} class="flex flex-col gap-1 text-sm">
            <span class="font-medium">
              {field.label}
              {field.required && <span aria-hidden="true"> *</span>}
            </span>
            <input
              id={inputId}
              type={field.type}
              name={field.name}
              placeholder={field.placeholder ?? ""}
              required={field.required}
              maxlength={field.maxLength}
              class={inputClass}
            />
          </label>
        );
      })}

      <button
        type="submit"
        class="self-start rounded-full bg-gray-950 px-6 py-2.5 text-sm font-medium text-white transition-colors hover:bg-gray-700"
      >
        Submit
      </button>

      {submitted && <p class="text-sm text-green-700">{form.successMessage || "Thanks — we got your message."}</p>}
      {formError && <p class="text-sm text-red-700">{formError}</p>}
    </form>
  )
}
