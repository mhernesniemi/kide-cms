{
  "name": "@kidecms/wordpress",
  "version": "0.2.0",
  "description": "WordPress → Kide CMS importer: scout a MySQL dump, map it with defineMapping, then kide-wp plan → apply → verify → check-live.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhernesniemi/kide-cms.git",
    "directory": "packages/wordpress"
  },
  "bin": {
    "kide-wp": "./bin/kide-wp.mjs"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "bin",
    "src",
    "!src/__tests__"
  ],
  "dependencies": {
    "@wordpress/autop": "5.1.0",
    "@wordpress/block-serialization-default-parser": "6.1.0",
    "@wordpress/shortcode": "5.1.0",
    "tsx": "^4.23.15"
  },
  "peerDependencies": {
    "@kidecms/core": ">=0.41.0",
    "better-sqlite3": "^12.0.0 || ^13.0.0"
  },
  "devDependencies": {
    "@kidecms/core": "workspace:*"
  },
  "scripts": {
    "check": "tsc --noEmit -p .",
    "test": "vitest run"
  }
}
